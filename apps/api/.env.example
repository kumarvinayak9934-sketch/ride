# Safar Share API — copy to .env and edit.  Never commit the real .env.

# --- runtime -------------------------------------------------------------
ENV=dev
HTTP_ADDR=:8080

# --- datastores ----------------------------------------------------------
DATABASE_URL=postgres://safar:safar@localhost:5432/safar?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- crypto / secrets (REQUIRED in prod; dev defaults below) -------------
# 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me-0123456789abcdef
# pepper for phone HMAC hashing
PHONE_HASH_PEPPER=dev-pepper-change-me
# 32-byte hex key for AES-GCM phone encryption (phone_enc column)
PHONE_ENC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# shared secret for payment-provider webhooks (HMAC-SHA256 over raw body)
WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- auth ---------------------------------------------------------------
# dev convenience: return the OTP in the response body (MUST be false in prod)
OTP_DEV_ECHO=true
# fixed-window rate limits
RATE_LIMIT_PER_MIN=600
OTP_RATE_LIMIT_PER_10MIN=3

# --- pricing (§5.3, tier-1 metros defaults) ------------------------------
PRICING_BASE_FARE=15
PRICING_KM_FARE=4.5
PRICING_MIN_FARE_PER_MIN=0.5
PRICING_MIN_FARE=40
PRICING_SURGE_CAP=1.5
PRICING_INTERCITY_THRESHOLD_KM=50
PRICING_CONV_FEE_LOCAL=19
PRICING_CONV_FEE_INTERCITY=29
PRICING_GST_PCT=18
# cost-cap inputs (mandatory clamp): fuel ₹/L, mileage km/L, maintenance ₹/km
COSTCAP_FUEL=104
COSTCAP_MILEAGE=15
COSTCAP_MAINT=1.8

# --- matching (§5.2) -----------------------------------------------------
MATCH_RADIUS_M=2000
# per-city ranking weights; city not listed -> defaults below (sum to 1.0)
# JSON: {"bangalore":{"detour":0.40,"time":0.25,"rating":0.20,"price":0.15}}
RANK_WEIGHTS={}

# --- payment / UPI -------------------------------------------------------
# merchant VPA used to build the UPI intent
UPI_VPA=safarshare@upi

# --- DigiLocker (§10) ----------------------------------------------------
DIGILOCKER_BASE_URL=https://api.digilocker.gov.in
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
# face-match vendor for liveness/selfie scoring (0.75 auto-verify threshold)
FACE_MATCH_URL=

# --- CORS ---------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
