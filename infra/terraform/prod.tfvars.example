# Copy to prod.tfvars and fill in. Keep out of git (see root .gitignore).
region             = "ap-south-1"
environment        = "prod"
db_instance_class  = "db.t4g.medium"
api_image          = "" # set by CI: <account>.dkr.ecr.../safar-share:<sha>
api_desired_count  = 2
allowed_origins    = "https://safar.example.com"

# Sensitive — prefer TF_VAR_db_password in the environment instead.
# db_password = "..."
